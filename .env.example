# Copy to .env and fill in real values. .env is git-ignored — docker compose
# reads it automatically and substitutes these into docker-compose.yml.
# Never commit .env or put real secrets back into docker-compose.yml.

# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=document_review
POSTGRES_PORT=5433

# --- API ---
API_PORT=3000
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret

# --- File storage (Cloudinary) ---
# Uploaded files live in Cloudinary, not on the container's own disk, so they
# survive a redeploy/restart even on hosts with an ephemeral filesystem (e.g.
# Render's free tier). Free tier needs no card on file. Sign up at
# https://cloudinary.com, then copy these three values from your dashboard's
# "API Environment variable" box (Console -> top of the Dashboard page).
CLOUDINARY_CLOUD_NAME=replace-with-your-cloud-name
CLOUDINARY_API_KEY=replace-with-your-api-key
CLOUDINARY_API_SECRET=replace-with-your-api-secret
