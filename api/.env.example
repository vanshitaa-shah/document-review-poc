# For running the api outside docker compose (e.g. `npm run dev` against a
# local Postgres). Copy to .env and fill in real values — this file is
# git-ignored and never committed with real secrets.
DATABASE_URL=postgresql://postgres:replace-with-a-strong-password@localhost:5433/document_review
PORT=3000
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret

# File storage (Cloudinary) — see .env.example at repo root for how to get these.
CLOUDINARY_CLOUD_NAME=replace-with-your-cloud-name
CLOUDINARY_API_KEY=replace-with-your-api-key
CLOUDINARY_API_SECRET=replace-with-your-api-secret

# Logging (optional). Leave OTEL_EXPORTER_OTLP_LOGS_ENDPOINT unset to log JSON to
# stdout only — nothing else in the app depends on OpenObserve being up.
LOG_LEVEL=info
OTEL_SERVICE_NAME=document-review-api
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://localhost:5080/api/default/v1/logs
# Must be "Authorization=Basic <base64 of email:password>" — see .env.example at repo root
OTEL_EXPORTER_OTLP_LOGS_HEADERS=Authorization=Basic replace-with-generated-value
