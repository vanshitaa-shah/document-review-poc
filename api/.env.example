DATABASE_URL=postgresql://postgres:postgres@postgres:5432/document_review
PORT=3000
JWT_SECRET=change-me-in-real-deployments
UPLOAD_DIR=/app/uploads

# Logging (optional). Leave OTEL_EXPORTER_OTLP_LOGS_ENDPOINT unset to log JSON to
# stdout only — nothing else in the app depends on OpenObserve being up.
LOG_LEVEL=info
OTEL_SERVICE_NAME=document-review-api
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://openobserve:5080/api/default/v1/logs
OTEL_EXPORTER_OTLP_LOGS_HEADERS=Authorization=Basic YWRtaW5AZXhhbXBsZS5jb206Q29tcGxleHBhc3MjMTIz
